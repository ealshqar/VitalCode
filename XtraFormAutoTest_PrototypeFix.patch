// محاولة الاتصال مع الجهاز الجديد (Prototype) أولاً
var prototypeResult = AutoCsaEmdUnitManagerPhase2.Instance.OpenPrototypeConnection(
    new SerialPortConnectionFilter(HardwareType.Prototype) 
    { 
        ComPortNumber = 0,      // كشف تلقائي
        AutoComPortDetection = true 
    });

if (!prototypeResult.IsSucceed)
{
    // إذا فشل، جرب منفذ محدد
    prototypeResult = AutoCsaEmdUnitManagerPhase2.Instance.OpenPrototypeConnection(
        new SerialPortConnectionFilter(HardwareType.Prototype) 
        { 
            ComPortNumber = 4,  // المنفذ المحدد في التعليق
            AutoComPortDetection = false 
        });
}

if (!prototypeResult.IsSucceed)
{
    // كحل أخير، جرب CSA القديم
    AutoCsaEmdUnitManagerPhase2.Instance.OpenCSAConnection();
}

