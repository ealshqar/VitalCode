<?xml version="1.0" encoding="utf-8"?>
<!-- 
    ملف إعدادات محاكي الجهاز الطبي
    Device Simulator Settings Configuration
    
    هذا الملف يتيح التحكم السهل في إعدادات المحاكاة
    بدون الحاجة لتعديل ملف App.config الرئيسي
-->
<configuration>
  <appSettings>
    
    <!-- ========== إعدادات المحاكاة الأساسية ========== -->
    
    <!-- تفعيل/إلغاء المحاكاة: true للمحاكاة، false للجهاز الحقيقي -->
    <add key="UseSimulatedReadings" value="true"/>
    
    <!-- نوع المحاكاة: random, stable, incremental, sine -->
    <add key="SimulationType" value="random"/>
    
    <!-- سرعة المحاكاة بالميلي ثانية (أقل = أسرع) -->
    <add key="SimulationSpeed" value="500"/>
    
    <!-- استخدام قراءات ثابتة فقط -->
    <add key="UseStableReadingsOnly" value="true"/>
    
    <!-- ========== إعدادات التوقيت ========== -->
    
    <!-- تأخير فحص الأجهزة (ميلي ثانية) -->
    <add key="HardwareCheckDelay" value="1000"/>
    
    <!-- تأخير استقرار القراءة (ميلي ثانية) -->
    <add key="ReadingStabilityDelay" value="10"/>
    
    <!-- تأخير ما بعد عنصر المرحلة (ميلي ثانية) -->
    <add key="StageAutoItemPostDelay" value="200"/>
    
    <!-- تأخير العنصر متعدد المستويات (ميلي ثانية) -->
    <add key="MultiLevelStageItemDelay" value="200"/>
    
    <!-- تأخير الجرعة (ميلي ثانية) -->
    <add key="ProductDosageDelay" value="200"/>
    
    <!-- تأخير أوامر CSA العامة (ميلي ثانية) -->
    <add key="CSAGeneralCommandDelay" value="200"/>
    
    <!-- ========== إعدادات القراءات المحاكاة ========== -->
    
    <!-- النطاق الأدنى للقراءات العشوائية -->
    <add key="MinRandomReading" value="0"/>
    
    <!-- النطاق الأعلى للقراءات العشوائية -->
    <add key="MaxRandomReading" value="100"/>
    
    <!-- القراءة الافتراضية عند البدء -->
    <add key="DefaultReading" value="50"/>
    
    <!-- تفعيل التحكم بلوحة المفاتيح -->
    <add key="EnableKeyboardControl" value="true"/>
    
    <!-- ========== إعدادات الجهاز الحقيقي ========== -->
    <!-- (تُستخدم عند UseSimulatedReadings = false) -->
    
    <!-- منفذ COM الافتراضي -->
    <add key="DefaultComPort" value="3"/>
    
    <!-- سرعة البيانات -->
    <add key="BaudRate" value="9600"/>
    
    <!-- بتات البيانات -->
    <add key="DataBits" value="8"/>
    
    <!-- نوع التماثل: None, Odd, Even -->
    <add key="Parity" value="None"/>
    
    <!-- بتات الإيقاف: One, Two -->
    <add key="StopBits" value="One"/>
    
    <!-- مهلة القراءة (ميلي ثانية) -->
    <add key="ReadTimeout" value="5000"/>
    
    <!-- تفعيل DTR -->
    <add key="EnableDTR" value="false"/>
    
    <!-- تفعيل RTS -->
    <add key="EnableRTS" value="false"/>
    
    <!-- ========== إعدادات التشخيص والتطوير ========== -->
    
    <!-- تفعيل وضع التشخيص -->
    <add key="EnableDiagnosticMode" value="true"/>
    
    <!-- تفعيل السجل المفصل -->
    <add key="EnableVerboseLogging" value="true"/>
    
    <!-- تفعيل مهلة انقطاع الاتصال الطويلة للتطوير -->
    <add key="EnableDebuggingLongHWDisconnectTimeout" value="true"/>
    
    <!-- مهلة انقطاع الاتصال الطويلة (ميلي ثانية) -->
    <add key="DebuggingLongHWDisconnectTimeout" value="900000"/>
    
    <!-- تفعيل الاستئناف التلقائي بعد فشل الأتمتة -->
    <add key="EnableAutomationPostFailureAutoResume" value="true"/>
    
    <!-- ========== إعدادات الفحوصات ========== -->
    
    <!-- تفعيل فحص الضغط -->
    <add key="PerformPressureCheck" value="true"/>
    
    <!-- تفعيل فحص الرطوبة -->
    <add key="PerformMoistureCheck" value="true"/>
    
    <!-- تفعيل فحص المفصلة -->
    <add key="PerformHingeCheck" value="true"/>
    
    <!-- ========== إعدادات المسح متعدد المستويات ========== -->
    
    <!-- عدد جولات الإقصاء في المسح متعدد المستويات -->
    <add key="MutliLevelScanningEliminationRounds" value="7"/>
    
    <!-- تأخير ما بعد عنصر المرحلة متعدد المستويات -->
    <add key="MutliLevelStageItemPostDelay" value="10"/>
    
    <!-- ========== إعدادات واجهة المستخدم ========== -->
    
    <!-- تفعيل عرض التشريح البشري ثلاثي الأبعاد -->
    <add key="UseHumanAnatomyView" value="false"/>
    
    <!-- عرض نافذة التحكم في المحاكي عند البدء -->
    <add key="ShowSimulatorControlOnStart" value="false"/>
    
    <!-- حفظ سجل القراءات في ملف -->
    <add key="SaveReadingsLog" value="true"/>
    
    <!-- مسار ملف سجل القراءات -->
    <add key="ReadingsLogPath" value="SimulatedReadings.log"/>
    
  </appSettings>
</configuration>